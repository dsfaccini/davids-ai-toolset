{
  "_comment": "Case matrix for block-broad-pkill.sh, read by block-broad-pkill.test.sh. The hook is global, so there is no in_scope field. It blocks pkill -f, killall -m, and any option after the pattern (BSD pkill stops parsing options at the first operand). pgrep follows the same rules only when its output is captured ($(...), backticks, | xargs) in a command that also runs kill; a bare pgrep that verifies a kill stays allowed. Quotes are stripped before parsing, so a quoted mention of pkill is not a pkill command unless a control operator inside the quotes starts a new segment.",
  "cases": [
    {"command": "cat /tmp/x.output; pkill -f \"cat\" -P $$ 2>/dev/null; ps aux | grep -v grep | grep \"x\\|cat$\" | head", "blocked": true},
    {"command": "pkill -f uvicorn", "blocked": true},
    {"command": "pkill -9 -f \"node server.js\"", "blocked": true},
    {"command": "pkill -lf vite", "blocked": true},
    {"command": "/usr/bin/pkill -f worker", "blocked": true},
    {"command": "sudo pkill -f worker", "blocked": true},
    {"command": "cd /tmp && pkill -f worker", "blocked": true},
    {"command": "pkill --full worker", "blocked": true},
    {"command": "pkill cat -P $$", "blocked": true},
    {"command": "pkill node -9", "blocked": true},
    {"command": "kill $(pgrep -f cat)", "blocked": true},
    {"command": "kill -9 `pgrep -f cat`", "blocked": true},
    {"command": "pgrep -f \"python server\" | xargs kill", "blocked": true},
    {"command": "pgrep node -l | xargs kill", "blocked": true},
    {"command": "killall -m cat", "blocked": true},
    {"command": "xargs pkill -f < names.txt", "blocked": true},
    {"command": "P=$(pgrep -f \"/tmp/pw-pr28/\"); [ -n \"$P\" ] && kill $P", "blocked": true},
    {"command": "for p in $(pgrep -f foo); do kill $p; done", "blocked": true},
    {"command": "pkill -x cat", "blocked": false},
    {"command": "pkill -P $$ -x cat", "blocked": false},
    {"command": "pkill -P $$ cat", "blocked": false},
    {"command": "pkill -P 4242 -x cat", "blocked": false},
    {"command": "pkill -u alice -x node", "blocked": false},
    {"command": "pkill -9 node", "blocked": false},
    {"command": "pkill -KILL -x node", "blocked": false},
    {"command": "pkill -- -weird-name", "blocked": false},
    {"command": "pgrep -lf cat", "blocked": false},
    {"command": "pgrep -f \"node server\" && echo running", "blocked": false},
    {"command": "ps aux | grep -v grep | grep pkill", "blocked": false},
    {"command": "grep -rn \"pkill -f\" hooks/", "blocked": false},
    {"command": "echo \"use pkill -f with care\"", "blocked": false},
    {"command": "killall Spotify", "blocked": false},
    {"command": "killall -9 node", "blocked": false},
    {"command": "kill 12345", "blocked": false},
    {"command": "kill -9 $(cat /tmp/server.pid)", "blocked": false},
    {"command": "pgrep -f foo; kill 123", "blocked": false},
    {"command": "kill 42559; pgrep -fl '^caffeinate -i'", "blocked": false},
    {"command": "P=$(pgrep -f foo); echo $P", "blocked": false},
    {"command": "git commit -F - <<'EOF'\nfix: guard\n\npkill -f (full command line match) and `pkill -f cat -P $$`\nEOF", "blocked": false},
    {"command": "cat > stop.sh <<EOF\npkill -f worker\nEOF\nchmod +x stop.sh", "blocked": false},
    {"command": "cat <<'EOF' > notes.md\nkill $(pgrep -f cat)\nEOF\npkill -f worker", "blocked": true}
  ]
}
